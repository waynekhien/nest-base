NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nest_base
DB_SYNCHRONIZE=false

JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
